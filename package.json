{
  "name": "rngdle-automation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "description": "Astro control dashboard and durable RNGdle automation on Cloudflare Workers.",
  "scripts": {
    "once": "node src/index.js once",
    "start": "astro dev",
    "poem:inspect": "node --env-file-if-exists=.env src/index.js inspect-poem",
    "poem": "node --env-file-if-exists=.env src/index.js poem",
    "test": "node --test test/*.test.js",
    "dev": "astro dev",
    "build": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false astro build",
    "preview": "astro preview",
    "deploy": "pnpm build && wrangler deploy",
    "start:legacy": "node src/index.js rngdle",
    "test:e2e": "playwright test",
    "cloudflare": "node scripts/cloudflare.mjs",
    "deploy:production": "CLOUDFLARE_WRANGLER_CONFIG=wrangler.production.jsonc pnpm build && wrangler deploy",
    "cloudflare:init": "node --env-file-if-exists=.env scripts/cloudflare.mjs init"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "acorn": "^8.18.0",
    "astro": "^7.4.0",
    "nodemailer": "9.0.3",
    "openai": "^7.18.0",
    "perfect-scrollbar": "1.5.6",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "wrangler": "^4.151.1"
  }
}
