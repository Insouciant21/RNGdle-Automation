{
  "name": "rngdle-automation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "description": "Self-hosted RNGdle automation with persistent login, retry-safe scheduling, SMTP reports, and a local control dashboard.",
  "scripts": {
    "once": "node src/index.js once",
    "start": "node src/index.js rngdle",
    "poem:inspect": "node --env-file-if-exists=.env src/index.js inspect-poem",
    "poem": "node --env-file-if-exists=.env src/index.js poem",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "acorn": "^8.18.0",
    "nodemailer": "9.0.3",
    "openai": "^7.18.0",
    "perfect-scrollbar": "1.5.6",
    "yaml": "^2.8.0"
  }
}
