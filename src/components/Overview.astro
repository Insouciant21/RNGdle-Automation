---
const { overview } = Astro.props;
const status = overview?.status ?? null;
const schedule = overview?.schedule ?? null;
const result = overview?.result ?? null;
const latest = overview?.latest ?? null;
const mail = overview?.mail ?? null;
const rarityKeys = ['trash','common','uncommon','rare','epic','anomaly','mythic'];
const rarityLabels = { trash:'Trash', common:'Common', uncommon:'Uncommon', rare:'Rare', epic:'Epic', anomaly:'Anomaly', mythic:'Mythic', unknown:'Rarity unavailable' };
const rarityIcons = { trash:'🟫', common:'⬜', uncommon:'🟩', rare:'🟦', epic:'🟪', anomaly:'🟧', mythic:'🟥', unknown:'?' };
const rarity = result && rarityKeys.includes(result.rarity) ? result.rarity : 'unknown';
const badges = Array.isArray(result?.badges) ? result.badges : null;
const count = (value) => value === null || value === undefined ? '-' : Number(value).toLocaleString('en-US');
const dateTime = (value) => value ? new Date(value).toLocaleString('en-US', { timeZone: 'UTC' }) + ' UTC' : '-';
const badgeRarityFromScore = (score) => { const value = Number(score); if (!Number.isFinite(value) || value < 0) return 'unknown'; if (value < 1000) return 'common'; if (value < 10000) return 'uncommon'; if (value < 100000) return 'rare'; if (value < 1000000) return 'epic'; if (value < 10000000) return 'anomaly'; return 'mythic'; };
const badgeRarity = (badge) => rarityKeys.includes(badge.rarity) ? badge.rarity : badgeRarityFromScore(badge.score);
---
<section id="view-overview" class="view">
      <div class="status-hero">
        <div class="status-frame"><strong id="status" class="status-copy" aria-live="polite">{status?.label ?? 'Loading'}</strong></div>
        <div class="meta"><span id="state-tag" class={`tag ${status?.state ?? 'connecting'}`}>{status?.state ?? 'Connecting'}</span><span aria-hidden="true">•</span><span id="schedule-meta">{schedule ? `${schedule.time} ${schedule.timezone}` : 'Loading schedule'}</span></div>
      </div>
      <div class="overview-grid">
        <div>
          <section class="section">
            <div class="section-heading"><h2>Latest roll</h2><span id="result-date" class="section-meta">{result?.date ?? 'No result'}</span></div>
            <div class="panel">
              <div class="result-summary"><span id="roll-number" class={`roll-number rarity-${rarity}`}>{result ? result.number : '------'}</span><div id="roll-rarity" class={`roll-rarity rarity-${rarity}`}><span id="roll-rarity-icon">{rarityIcons[rarity]}</span><span id="roll-rarity-label">{rarityLabels[rarity]}</span></div></div>
              <div class="stats">
                <div class="stat"><span id="earned-ep" class="stat-value">{result ? count(result.earnedEp) : '-'}</span><span class="stat-label">Earned EP</span></div>
                <div class="stat"><span id="total-ep" class="stat-value">{result ? count(result.totalEp) : '-'}</span><span class="stat-label">Lifetime EP</span></div>
                <div class="stat"><span id="badge-count" class="stat-value">{result ? (badges ? badges.length : result.badges) : '-'}</span><span class="stat-label">Badges</span></div>
                <div class="stat"><span id="mail-state" class="stat-value">{latest ? (latest.emailSent ? 'Sent' : 'Pending') : '-'}</span><span class="stat-label">Email</span></div>
              </div>
              <div id="poem-section" class="badge-breakdown" hidden={!result?.poem}><div class="badge-breakdown-heading"><span>Poem</span></div><p id="poem-text">{result?.poem}</p></div>
              <div class="badge-breakdown"><div class="badge-breakdown-heading"><span>Badge breakdown</span><span id="badge-count-label" class="section-meta">{badges ? `${badges.length} badge${badges.length === 1 ? '' : 's'}` : '-'}</span></div><div id="badge-list" class="badge-list">
                {badges?.length ? badges.map((badge) => (
                  <div class={`badge-item rarity-${badgeRarity(badge)}`}>
                    <span class="badge-emoji">{badge.emoji || '✨'}</span>
                    <div class="badge-copy">
                      <div class="badge-name">{badge.label || badge.id || 'Unknown badge'}{badge.isNew && <span class="badge-new">NEW</span>}</div>
                      {badge.description && <div class="badge-description">{badge.description}</div>}
                    </div>
                    <div class="badge-meta"><span class="badge-rarity">{rarityLabels[badgeRarity(badge)]}</span><span class="badge-score">+{count(badge.score)} EP</span></div>
                  </div>
                )) : <div class="badge-empty">{result ? 'No badges earned' : 'No badge data'}</div>}
              </div></div>
            </div>
          </section>
        </div>
        <aside>
          <section class="section">
            <div class="section-heading"><h2>Run state</h2><span id="run-date" class="section-meta">{latest?.date ?? 'Today'}</span></div>
            <div class="panel">
              <div class="detail-row"><span class="detail-label">Status</span><strong id="run-status" class="detail-value">{latest?.status ?? '-'}</strong></div>
              <div class="detail-row"><span class="detail-label">RNGdle attempts</span><strong id="run-attempts" class="detail-value">{latest?.attempts ?? '-'}</strong></div>
              <div class="detail-row"><span class="detail-label">RNGdle next retry</span><strong id="next-rngdle-retry" class="detail-value">{latest ? dateTime(latest.nextRngdleRetryAt) : '-'}</strong></div>
              <div class="detail-row"><span class="detail-label">Poem automation</span><strong id="poem-enabled" class="detail-value">{schedule ? (schedule.poemEnabled ? 'Enabled' : 'Disabled') : '-'}</strong></div>
              <div class="detail-row"><span class="detail-label">Poem attempts</span><strong id="poem-attempts" class="detail-value">{latest?.poemAttempts ?? '-'}</strong></div>
              <div class="detail-row"><span class="detail-label">Poem next retry</span><strong id="next-poem-retry" class="detail-value">{latest ? dateTime(latest.nextPoemRetryAt) : '-'}</strong></div>
              <div class="detail-row"><span class="detail-label">Email attempts</span><strong id="email-attempts" class="detail-value">{latest?.emailAttempts ?? '-'}</strong></div>
              <div class="detail-row"><span class="detail-label">Email next retry</span><strong id="next-email-retry" class="detail-value">{latest ? dateTime(latest.nextEmailRetryAt) : '-'}</strong></div>
              <div class="detail-row"><span class="detail-label">Recipients</span><strong id="mail-recipients" class="detail-value">{mail ? mail.to.join(', ') : '-'}</strong></div>
            </div>
          </section>
          <section class="section">
            <div class="section-heading"><h2>Email</h2><span class="section-meta">Result delivery</span></div>
            <div class="panel">
              <div class="sidebar-actions">
                <button id="email-send" class="button" type="button">Send email</button>
                <a id="preview-open" class="button quiet" href="/preview/email?type=result" target="_blank">Open preview</a>
                <div id="email-message" class="feedback email-feedback" role="status"></div>
              </div>
            </div>
          </section>
          <section id="error-section" class="section" hidden={!latest?.lastError}>
            <div class="section-heading"><h2>Last error</h2></div>
            <div class="panel"><div class="detail-row"><span id="last-error" class="detail-value" style="text-align:left">{latest?.lastError ?? ''}</span></div></div>
          </section>
        </aside>
      </div>
    </section>
