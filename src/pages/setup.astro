---
import AuthLayout from '../layouts/AuthLayout.astro';
const setupDisabled = Astro.locals.session?.setupDisabled;
---
<AuthLayout title="Set up RNGdle Control">
{setupDisabled ? <main class="setup"><h1>Control setup is disabled</h1><p class="note">Restore a backup or enable first-run setup to create a Control password.</p></main> : <>
<main class="setup">
    <h1>Set up RNGdle Control</h1>
    <p>First-run access protection</p>
    <p class="note">Create the password used to access this Control page. Your password is stored as a one-way hash.</p>
    <form id="setup-form">
      <label for="password">Control password</label>
      <input id="password" type="password" autocomplete="new-password" minlength="8" required>
      <label for="confirmation">Confirm password</label>
      <input id="confirmation" type="password" autocomplete="new-password" minlength="8" required>
      <button id="submit" type="submit">Create password</button>
      <div id="feedback" class="feedback" role="alert"></div>
    </form>
  </main>
</>}
</AuthLayout>
<script>import '../client/setup.js';</script>
