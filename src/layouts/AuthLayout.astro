---
import '@fontsource-variable/inter';
import '@fontsource/space-mono/400.css';
import '../styles/auth.css';
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>
