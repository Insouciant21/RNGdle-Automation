TZ=Asia/Shanghai
SCHEDULE_TIME=08:02
RETRY_MINUTES=30
EMAIL_RETRY_MINUTES=1

RNGDLE_EMAIL=
MAIL_TO=
MAIL_FROM=
MAIL_FROM_NAME=RNGdle Today

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=

# Use the credential format required by your SMTP provider.
SMTP_AUTH_MODE=password
SMTP_PASSWORD=
# SMTP_APP_PASSWORD is accepted as a legacy alias.
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
SMTP_OAUTH_REFRESH_TOKEN=
SMTP_OAUTH_ACCESS_URL=

CONTROL_PUBLIC_URL=http://localhost:3000
