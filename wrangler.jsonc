{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rngdle-automation",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "directory": "./dist" },
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "limits": { "cpu_ms": 30000 },
  "vars": {
    "CONTROL_PUBLIC_URL": "https://your-worker-name.your-subdomain.workers.dev",
    "ALLOW_SETUP": "true",
    "TZ": "Asia/Shanghai",
    "SCHEDULE_TIME": "08:02",
    "RETRY_MINUTES": "30",
    "EMAIL_RETRY_MINUTES": "1",
    "CONTROL_SESSION_DAYS": "7",
    "SMTP_PORT": "587",
    "SMTP_SECURE": "false",
    "SMTP_REQUIRE_TLS": "true",
    "SMTP_AUTH_MODE": "password",
    "MAIL_FROM_NAME": "RNGdle Today",
    "MAIL_SUBJECT_PREFIX": "[RNGdle]",
    "POEM_ENABLED": "false",
    "POEM_RETRY_MINUTES": "5",
    "RETURN_LIKES_ENABLED": "false",
    "RETURN_LIKES_POLL_MINUTES": "60",
    "RETURN_LIKES_MAX_PER_DAY": "10",
    "RETURN_LIKES_LOOKBACK_DAYS": "7",
    "LLM_ENDPOINT": "https://api.deepseek.com",
    "LLM_MODEL": "deepseek-flash",
    "LLM_MAX_TOKENS": "2048",
    "LLM_MAX_ATTEMPTS": "3",
    "LLM_THINKING": "disabled"
  },
  "durable_objects": {
    "bindings": [{ "name": "AUTOMATION", "class_name": "Automation" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Automation"] }],
  "env": {
    "staging": {
      "name": "rngdle-automation-staging",
      "routes": [],
      "vars": {
        "CONTROL_PUBLIC_URL": "https://your-worker-name.your-subdomain.workers.dev",
        "ALLOW_SETUP": "true"
      },
      "durable_objects": {
        "bindings": [{ "name": "AUTOMATION", "class_name": "Automation" }]
      }
    }
  }
}
